+  assert.equal(seed.departments.filter(item => !item.manager).length, 1)
+  assert.equal(seed.tariffs.map(item => item.name).join('|'), 'Helseavtalen|Omsorgsavtalen|Spesialistavtalen')
+  assert.equal(seed.employees.length, 10)
