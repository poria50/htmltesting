+  api.dispatchWith('open-absence', { id: String(s.id), slotId: String(s.slots[0]), employeeId: '102' })
+  api.fillForm({ generalAbsenceScope: 'partial', generalAbsenceStartDate: m1(12), generalAbsenceStartTime: '12:00', generalAbsenceEndDate: m1(12), generalAbsenceEndTime: '14:00', generalAbsenceComment: 'Forlot vakten to timer - ikke avklart' })
+  api.dispatchAction('confirm-absence'); if (err()) fail(`fravær: ${JSON.stringify(err())}`)
+  submit(s.id, s.slots[0], { actualStart: '07:00', actualEnd: '15:00' })
+  summary.submitted += 1
+  // === Sykefravær med erstatter (replacement-case) ===
+  s = shift({ departmentId: '11', template: templateId.day, date: m1(15) }); assign(s.id, s.slots[0], '103')
+  api.dispatchWith('open-sick-leave', { employeeId: '103', assignmentId: String(s.id) })
+  api.fillForm({ absenceScope: 'full_shift', absencePercent: '100', documentationType: 'medical_certificate', costResponsibility: 'contractor' })
+  api.dispatchAction('confirm-sick-leave'); if (err()) fail(`sykefravær: ${JSON.stringify(err())}`)
+  api.dispatchAction('close-dialog')
+  const replacementSlot = api.staffingSlots(s.id).find(slot => slot.replacementForSlotId)
+  if (!replacementSlot) fail('erstatterplass mangler')
+  assign(s.id, replacementSlot.id, '110')
+  submit(s.id, replacementSlot.id, { actualStart: '07:00', actualEnd: '15:00' }); approve(s.id, replacementSlot.id)
+  summary.approved += 1
+  // === Medlever (live-in) - tildelt, ikke levert ===
+  api.dispatchAction('create-shift-template'); api.fillForm({ name: 'Medlever 3 døgn', clientId: '1', type: 'live_in', startTime: '10:00', liveInDays: 3, liveInOverlap: true }); api.dispatchAction('save-shift-template')
+  const liveIn = api.getData().shiftTemplates.at(-1); if (liveIn.type !== 'live_in') fail('medlevermal feilet')
+  api.dispatchAction('create-assignment'); api.fillForm({ clientId: '1', departmentId: '12', shiftTemplateId: liveIn.id, date: m1(21), startTime: liveIn.startTime, endTime: liveIn.endTime, breakMinutes: 0, slots: 1 }); api.dispatchAction('save-assignment'); if (err()) fail(`medlever: ${JSON.stringify(err())}`)
+  const liveInShift = api.getData().assignments.at(-1); assign(liveInShift.id, api.staffingSlots(liveInShift.id)[0].id, '104')
+  summary.notSubmitted += 1
+  // === Ikke levert: neste måned, flere avdelinger, helg, natt, to plasser ===
+  s = shift({ departmentId: '13', template: templateId.day, date: m2(5) }); assign(s.id, s.slots[0], '105')
+  s = shift({ departmentId: '11', template: templateId.evening, date: m2(6) }); assign(s.id, s.slots[0], '106')
+  s = shift({ departmentId: '11', template: templateId.night, date: m2(7) }); assign(s.id, s.slots[0], '107')
+  s = shift({ departmentId: '12', template: templateId.day, date: m2(demoMonths(now).sat2) }); assign(s.id, s.slots[0], '108')
+  s = shift({ departmentId: '13', template: templateId.day, date: m2(13), slots: 2 }); assign(s.id, s.slots[0], '109'); assign(s.id, s.slots[1], '110', teamLead.id)
+  s = shift({ departmentId: '14', template: templateId.evening, date: m2(20) }); assign(s.id, s.slots[0], '101')
+  shift({ departmentId: '11', template: templateId.day, date: m2(27), slots: 2 }) // åpen bemanning
+  summary.notSubmitted += 7
+
+  // === Selvkontroll mot de kanoniske motorene ===
+  if (api.staffingIntegrityAudit().length) fail('integritetskonflikter i seed')
+  const basis = api.payrollBasis()
+  if (basis.lines.filter(line => line.sourceType !== 'sick_leave_compensation').length !== summary.approved) fail(`forventet ${summary.approved} lønnslinjer, fikk ${basis.lines.length}`)
+  const night = basis.lines.find(line => line.actualStart === '22:00'); if (!night || Math.round(night.premiumAmount) <= 0) fail('nattillegg mangler')
+  const weekend = basis.lines.find(line => line.date === m1(sat1)); if (!weekend || Math.round(weekend.premiumAmount) !== Math.round(weekend.hours * 60)) fail('helgetillegg mangler')
+  const fn = basis.lines.find(line => line.employeeId === '105'); if (!fn || !fn.premiumLines.some(item => item.family === 'function')) fail('funksjonstillegg mangler')
+  const overtime = basis.lines.find(line => line.employeeId === '110' && line.actualEnd === '18:00'); if (!overtime || overtime.overtimeHours <= 0) fail('overtid mangler')
+
+  const seed = JSON.parse(storage.getItem(DEMO_STORAGE_KEY))
+  if (!seed || seed.meta?.version !== seedVersion) fail('persistert seed mangler')
+  const employeeMonths = [m1(1), m2(1)]
+  return { seed, summary: { ...summary, months: employeeMonths, shifts: seed.assignments.length, timesheets: seed.slotTimesheets.filter(item => !item.voided && !item.superseded).length, employees: seed.employees.length, payrollLines: basis.lines.length, sickLines: basis.lines.filter(line => line.sourceType === 'sick_leave_compensation').length } }
+}
+
+if (process.argv[1] === fileURLToPath(import.meta.url)) {
+  const { seed, summary } = buildDemoSeed()
+  mkdirSync(join(here, 'dist'), { recursive: true })
+  writeFileSync(join(here, 'dist', 'demo-seed.json'), JSON.stringify(seed))
+  console.log(`Skrev dist/demo-seed.json`, JSON.stringify(summary))
+}
