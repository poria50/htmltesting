+  assert.ok(count('not_submitted') >= 5)
+  assert.ok(active.some(item => item.status === 'submitted' && item.deviationNote))
+  assert.equal(seed.absences.filter(item => item.status === 'pending').length, 1)
+  assert.equal(seed.sickLeaves.length, 1)
+  assert.ok(seed.assignments.some(item => item.staffingSlots.some(slot => slot.replacementForSlotId && slot.employeeId)))
+  assert.ok(seed.shiftTemplates.some(item => item.type === 'live_in'))
+  assert.ok(seed.assignments.some(item => item.liveInSnapshot))
+  assert.ok(seed.premiumRules.some(item => item.family === 'date'))
+  assert.ok(seed.premiumRules.some(item => item.family === 'function'))
