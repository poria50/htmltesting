+// === Integritetsrunde: godkjenningsgater + sykeblokkere med full kontekst ===
+
+function submittedShift(preview, { date = '2026-10-20', employeeId = 'e1', departmentId = 'd1', clientId = 'c1' } = {}) {
+  const shift = plainShift(preview, { clientId, departmentId, date, startTime: '08:00', endTime: '16:00' })
+  const slotId = assignTo(preview, shift, employeeId).id
+  preview.api.dispatchSlot('open-slot-timesheet', shift.id, String(slotId))
+  preview.api.fillForm({ actualStart: '08:00', actualEnd: '16:00', actualBreakMinutes: '0' })
+  preview.api.dispatchAction('submit-slot-timesheet')
+  return { shift, slotId, sheet: () => preview.api.slotTimesheet(shift.id, String(slotId)) }
+}
+
+function withoutApprover(preview, fn) {
+  const d1 = preview.api.find('departments', 'd1'); const manager = d1.manager; d1.manager = ''
+  // Fallback-godkjenneren er klientens aktive kontaktperson - deaktiver dem midlertidig.
+  const contacts = preview.api.getData().contacts.filter(item => item.clientId === 'c1').map(item => [item.id, item.status])
+  for (const [id] of contacts) preview.api.find('contacts', id).status = 'inactive'
+  try { return fn() } finally { d1.manager = manager; for (const [id, status] of contacts) preview.api.find('contacts', id).status = status }
+}
+
+test('gate 1+2: a pending absence blocks single AND bulk approval - no snapshot until the absence is reviewed', () => {
+  const preview = loadPreview('#timesheets')
+  const { shift, slotId, sheet } = submittedShift(preview)
+  const absence = registerAbsence(preview, shift.id, slotId, 'e1', { generalAbsenceScope: 'partial', generalAbsenceStartDate: '2026-10-20', generalAbsenceStartTime: '12:00', generalAbsenceEndDate: '2026-10-20', generalAbsenceEndTime: '14:00' })
+  assert.equal(absence.status, 'pending')
+  // Enkeltgodkjenning avvises - status og snapshot urørt.
+  preview.api.dispatchSlot('open-slot-timesheet', shift.id, String(slotId))
+  const dialog = preview.elements.get('dialog-root').innerHTML
+  assert.doesNotMatch(dialog, /data-action="approve-slot-timesheet"/)
+  assert.match(dialog, new RegExp(`data-action="open-absence-review" data-id="${absence.id}"`))
+  assert.match(dialog, /Ventende fravær må vurderes før timelisten kan godkjennes/)
+  preview.api.dispatchAction('approve-slot-timesheet')
+  assert.equal(preview.api.getState().formError, 'absence.pendingBlocksApproval')
+  assert.equal(sheet().status, 'submitted')
+  assert.equal((sheet().approvalVersions ?? []).length, 0)
+  preview.api.dispatchAction('close-dialog')
+  // Køen: Blokkert med konkret handling (vurder fraværet), ikke valgbar for bulk.
+  preview.api.setTimesheetFilter('month', '2026-10')
+  preview.api.go('timesheets')
+  preview.api.dispatchWith('timesheet-queue-tab', { value: 'awaiting' })
+  const page = preview.elements.get('main-content').innerHTML
+  assert.match(page, /Ventende fravær må vurderes/)
+  assert.match(page, new RegExp(`data-action="open-absence-review" data-id="${absence.id}"`))
+  assert.doesNotMatch(page, new RegExp(`data-action="toggle-timesheet-selection" data-id="${sheet().id}"`))
+  // Samlegodkjenning avvises selv om raden tvinges inn i utvalget.
+  preview.api.dispatchWith('toggle-timesheet-selection', { id: String(sheet().id) })
+  preview.api.dispatchAction('open-bulk-approve')
+  preview.api.dispatchAction('confirm-bulk-approve')
+  assert.equal(sheet().status, 'submitted')
+  assert.equal((sheet().approvalVersions ?? []).length, 0)
+  preview.api.dispatchAction('close-dialog')
+  // Lønn viser samme blokkering med samme handling.
+  preview.api.setPayrollPeriod('2026-10-01', '2026-10-31'); preview.api.go('payroll')
+  assert.match(preview.elements.get('main-content').innerHTML, new RegExp(`Ventende fravær må vurderes[\\s\\S]*data-action="open-absence-review" data-id="${absence.id}"`))
+  // Etter vurdering (ugyldig): godkjenning går gjennom og fryser 6 t - aldri 8.
+  preview.api.dispatchWith('open-absence-review', { id: String(absence.id) })
+  preview.api.fillForm({ generalAbsenceDecisionComment: 'Ikke dokumentert' })
+  preview.api.dispatchAction('absence-mark-invalid')
+  preview.api.dispatchSlot('open-slot-timesheet', shift.id, String(slotId))
+  assert.match(preview.elements.get('dialog-root').innerHTML, /data-action="approve-slot-timesheet"/)
+  preview.api.dispatchAction('approve-slot-timesheet')
+  assert.equal(sheet().status, 'approved')
+  assert.equal(sheet().approvalVersions.at(-1).payableWorkedMinutes, 360)
+  assert.equal(preview.api.payrollBasis().lines.find(line => line.assignmentId === shift.id).hours, 6)
+})
+
+test('gate 3+4+5: without a configured approver neither single nor bulk approval happens - never a demo-admin snapshot', () => {
+  const preview = loadPreview('#timesheets')
+  const { shift, slotId, sheet } = submittedShift(preview)
+  withoutApprover(preview, () => {
+    preview.api.dispatchSlot('open-slot-timesheet', shift.id, String(slotId))
+    const dialog = preview.elements.get('dialog-root').innerHTML
+    assert.doesNotMatch(dialog, /data-action="approve-slot-timesheet"/)
+    assert.match(dialog, /data-route="department-detail" data-id="d1"[^>]*>Konfigurer godkjenner/)
+    preview.api.dispatchAction('approve-slot-timesheet')
+    assert.equal(preview.api.getState().formError, 'timesheets.noApprover')
+    assert.equal(sheet().status, 'submitted')
+    assert.equal(sheet().approvedBy, undefined)
+    assert.equal((sheet().approvalVersions ?? []).length, 0)
+    preview.api.dispatchAction('close-dialog')
+    preview.api.setTimesheetFilter('month', '2026-10'); preview.api.go('timesheets')
+    preview.api.dispatchWith('timesheet-queue-tab', { value: 'awaiting' })
+    preview.api.dispatchWith('toggle-timesheet-selection', { id: String(sheet().id) })
+    preview.api.dispatchAction('open-bulk-approve')
+    preview.api.dispatchAction('confirm-bulk-approve')
+    assert.equal(sheet().status, 'submitted')
+    preview.api.dispatchAction('close-dialog')
+  })
+  // Ingen godkjenning er signert av systemidentiteten - verken på timelisten eller i noe snapshot.
+  assert.equal(preview.api.getData().slotTimesheets.some(item => item.approvedBy === 'demo-admin' || (item.approvalVersions ?? []).some(version => version.approvedBy === 'demo-admin')), false)
+  // Med godkjenner på plass: samme timeliste godkjennes og signeres av godkjenneren.
+  preview.api.dispatchSlot('open-slot-timesheet', shift.id, String(slotId))
+  preview.api.dispatchAction('approve-slot-timesheet')
+  assert.equal(sheet().status, 'approved')
+  assert.equal(sheet().approvedBy, 'Kari Nilsen')
+  assert.equal(sheet().approvalVersions.at(-1).approvedBy, 'Kari Nilsen')
+})
+
+test('gate 6-10: sick blockers carry full context - they survive business/department filters, show on the employee detail and gate invoicing only in scope', () => {
+  const preview = loadPreview('#payroll')
+  // e1: pending sykefravær (validity ikke vurdert) på en c1/d1-vakt i oktober.
+  const shift = plainShift(preview, { date: '2026-10-21', startTime: '08:00', endTime: '16:00' })
+  assignTo(preview, shift, 'e1')
+  const sick = registerShiftSick(preview, shift, 'e1', { absenceScope: 'full_shift' })
+  // Registrering er automatisk gyldig; kompensasjonen settes til vurdering
+  // (samme kanoniske tilstand som etter en avvist/ny vurdering).
+  preview.api.find('sickLeaves', sick.id).compensationStatus = 'pending'
+  const blocker = preview.api.payrollBasis().blocked.find(item => String(item.sickLeaveId) === String(sick.id))
+  assert.ok(blocker, 'sykeblokkering mangler')
+  assert.equal(blocker.reasonKey, 'sick.needsReview')
+  assert.equal(blocker.employeeId, 'e1')
+  assert.equal(blocker.assignmentId, shift.id)
+  assert.equal(blocker.clientId, 'c1')
+  assert.equal(blocker.departmentId, 'd1')
+  assert.equal(blocker.client?.id, 'c1')
+  preview.api.setPayrollPeriod('2026-10-01', '2026-10-31')
+  const banner = new RegExp(`Sykefravær må avklares[\\s\\S]*?data-action="open-sick-leave-detail" data-id="${sick.id}"`)
+  // Virksomhetsfilter c1: beholdes. Avdelingsfilter d1: beholdes. c2: borte.
+  preview.api.setPayrollFilter('clientId', 'c1')
+  assert.match(preview.elements.get('main-content').innerHTML, banner)
+  preview.api.setPayrollFilter('departmentId', 'd1')
+  assert.match(preview.elements.get('main-content').innerHTML, banner)
+  preview.api.setPayrollFilter('departmentId', '')
+  preview.api.setPayrollFilter('clientId', 'c2')
+  assert.doesNotMatch(preview.elements.get('main-content').innerHTML, /Sykefravær må avklares/)
+  preview.api.setPayrollFilter('clientId', '')
+  // Ansattdetaljen viser blokkeringen for riktig ansatt - og ikke for andre.
+  preview.api.go('payroll-employee', 'e1')
+  assert.match(preview.elements.get('main-content').innerHTML, /Sykefravær må avklares/)
+  preview.api.go('payroll-employee', 'e2')
+  assert.doesNotMatch(preview.elements.get('main-content').innerHTML, /Sykefravær må avklares/)
+  // Fakturering: i scope (c1, oktober) stopper den ferdigstilling; c2 påvirkes ikke.
+  const before = (preview.api.getData().invoiceReports ?? []).length
+  preview.api.setInvoiceReportForm({ clientId: 'c1', fromDate: '2026-10-01', toDate: '2026-10-31' })
+  preview.api.go('invoicing')
+  assert.match(preview.elements.get('main-content').innerHTML, banner)
+  preview.api.dispatchAction('finalize-invoice-report')
+  assert.equal((preview.api.getData().invoiceReports ?? []).length, before)
+  approvedShiftAt(preview, { date: '2026-10-22', clientId: 'c2', departmentId: 'd2', role: 'healthcare_worker' })
+  preview.api.setInvoiceReportForm({ clientId: 'c2', fromDate: '2026-10-01', toDate: '2026-10-31' })
+  assert.doesNotMatch(preview.elements.get('main-content').innerHTML, /Sykefravær må avklares/)
+  preview.api.dispatchAction('finalize-invoice-report')
+  assert.equal((preview.api.getData().invoiceReports ?? []).length, before + 1)
+  // Utenfor perioden (november) blokkerer den heller ikke c1.
+  preview.api.setInvoiceReportForm({ clientId: 'c1', fromDate: '2026-11-01', toDate: '2026-11-30' })
+  assert.doesNotMatch(preview.elements.get('main-content').innerHTML, /Sykefravær må avklares/)
+  // Handlingen åpner NØYAKTIG sykefraværssaken.
+  preview.api.dispatchOn('open-sick-leave-detail', String(sick.id))
+  assert.equal(preview.api.getState().dialog, 'sick-leave-detail')
+  assert.equal(String(preview.api.getState().slotAction?.sickLeaveId), String(sick.id))
+})
