+// Månedene demoen dekker: inneværende + neste (relativt til byggedato).
+function demoMonths(now = new Date()) {
+  const first = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), 1))
+  const next = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth() + 1, 1))
+  const iso = (base, day) => new Date(Date.UTC(base.getUTCFullYear(), base.getUTCMonth(), day)).toISOString().slice(0, 10)
+  const weekendDay = base => { for (let day = 1; day <= 28; day += 1) { const date = new Date(Date.UTC(base.getUTCFullYear(), base.getUTCMonth(), day)); if (date.getUTCDay() === 6) return day } return 6 }
+  return { m1: day => iso(first, day), m2: day => iso(next, day), sat1: weekendDay(first), sat2: weekendDay(next) }
+}
