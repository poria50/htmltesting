+  // Lønnstabell: laveste årslønn 300 000, +20 % per system, årsverksgrunnlag komplett, timesats avledet.
+  const min = tariff => Math.min(...tariff.versions[0].salaryCells.map(cell => cell.annualSalary))
+  assert.equal(min(seed.tariffs[0]), 300000)
+  assert.equal(min(seed.tariffs[1]), 360000)
+  assert.equal(min(seed.tariffs[2]), 432000)
+  assert.equal(seed.tariffs[0].versions[0].salaryCells.length, 36)
+  for (const key of ['day', 'evening', 'night', 'live_in']) assert.ok(seed.tariffs[0].versions[0].annualBasisRules[key] > 0)
+  assert.equal(seed.tariffs[0].versions[0].annualHoursBasis, 1950)
+  assert.ok(seed.tariffs[0].versions[0].salaryCells.every(cell => Math.abs(cell.rate - cell.annualSalary / 1950) < 1e-9))
+  // Kun numeriske ID-er på vakter, plasser og timelister.
+  assert.ok(seed.assignments.every(item => /^\d+$/.test(String(item.id))))
+  assert.ok(seed.assignments.every(item => item.staffingSlots.every(slot => /^\d+$/.test(String(slot.id)))))
+  assert.ok(seed.slotTimesheets.every(item => /^\d+$/.test(String(item.id))))
+  // Representative tilstander og caser.
+  const active = seed.slotTimesheets.filter(item => !item.voided && !item.superseded)
+  const count = status => active.filter(item => item.status === status).length
