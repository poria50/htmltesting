+// Årslønn: laveste nivå 300 000, +20 % per kompetansenivå, +4 % per
+// ansiennitetstrinn - runde, lettleste tall. Timesatsen avledes av
+// årsverksgrunnlaget (annualSalary / timer), aldri hardkodet separat.
+function salaryCells({ systemId, base }) {
+  const cells = []
+  EDUCATION_LEVELS.forEach((education, level) => {
+    SENIORITY_STEPS.forEach(([min, max], step) => {
+      const annualSalary = Math.round(base * (1.2 ** level) * (1.04 ** step) / 100) * 100
+      cells.push({ id: `cell-${systemId}-${education}-${min}`, role: '', education, seniorityMin: min, seniorityMax: max, annualSalary, rate: annualSalary / ANNUAL_HOURS, unit: 'hourly' })
+    })
+  })
+  return cells
+}
