+++ b/preview/platform/build-demo-seeded.mjs
@@ -0,0 +1,26 @@
+// Bygger den EKSTRA, selvstendige demo-distribusjonen workmatic-demo-seeded.html:
+// samme app som dist/workmatic-preview.html, men med et ferdig seedet,
+// kanonisk datasett innebygd i selve HTML-en (ikke bare localStorage) og et
+// isolert lagringsnavnerom, slik at den aldri rører referansefilens data.
+// Referansefilen (workmatic-preview.html / deploy/index.html / artifact) er urørt.
+//
+//   node preview/platform/build-demo-seeded.mjs
+import { readFileSync, writeFileSync } from 'node:fs'
+import { dirname, join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { buildDemoSeed, DEMO_STORAGE_KEY } from './build-demo-seed.mjs'
+
+const here = dirname(fileURLToPath(import.meta.url))
+const source = readFileSync(join(here, 'dist', 'workmatic-preview.html'), 'utf8')
+const { seed, summary } = buildDemoSeed()
+const marker = '<script>\n'
+if (!source.includes(marker)) throw new Error('Fant ikke app-skriptet i workmatic-preview.html')
+const inject = `<script>/* WORKMATIC DEMO (seeded): innebygd kanonisk testdatasett - referansefilen er urørt */globalThis.__WORKMATIC_STORAGE_KEY__ = ${JSON.stringify(DEMO_STORAGE_KEY)}; globalThis.__WORKMATIC_EMBEDDED_SEED__ = ${JSON.stringify(seed)};</script>\n`
+const output = source
+  .replace('<title>Workmatic · Static demo</title>', '<title>Workmatic · Seeded demo (Nordlys Omsorg AS)</title>')
+  .replace(marker, inject + marker)
+if (!output.includes('__WORKMATIC_EMBEDDED_SEED__ = {')) throw new Error('Seed ble ikke injisert')
+if (/https?:\/\/(?!www\.w3\.org)/.test(output)) throw new Error('Demo-fila inneholder en ekstern URL')
+const target = join(here, 'dist', 'workmatic-demo-seeded.html')
+writeFileSync(target, output)
+console.log(`Skrev ${target} (${Math.round(Buffer.byteLength(output) / 1024)} kB)`, JSON.stringify(summary))
